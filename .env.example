# Google Gemini – Get a FREE key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (optional). If set, FinTrack will save and load data from your Supabase project.
# Get these from: https://supabase.com/dashboard → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase service_role key — server-side only (no VITE_ prefix, never sent to the browser).
# Bypasses RLS; the Express server is the only trusted path to the database. Get it from
# Dashboard → Settings → API → "service_role" (secret) key. Guard this like a password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: override chat API base (production). Dev uses Vite proxy to localhost:3001.
# VITE_CHAT_API_URL=
# VITE_CHAT_API_SECRET=

# Google OAuth – required for real Google Sign-In (optional; falls back to demo mode)
# Get yours at: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorised JavaScript origins: http://localhost:8080 or http://127.0.0.1:8080
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Resend – sends the first-sign-in welcome email (server-side only, no VITE_ prefix).
# Get a free key at: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
# Sender address. Without a verified domain in Resend, you're limited to onboarding@resend.dev,
# which can only deliver to the email address on your own Resend account — fine for testing,
# but you'll need to verify a domain in Resend to email real users. See https://resend.com/domains
RESEND_FROM_EMAIL=FinTrack <onboarding@resend.dev>
